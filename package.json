{
  "name": "reviewer-2",
  "version": "1.0.1",
  "description": "Professional peer review application for scholarly documents",
  "main": "main.js",
  "scripts": {
    "vendor:assets": "node scripts/vendor-assets.js",
    "prestart": "node scripts/vendor-assets.js",
    "start": "electron .",
    "prestart:dev": "node scripts/vendor-assets.js",
    "start:dev": "electron . --dev",
    "prebuild": "node scripts/vendor-assets.js",
    "build": "electron-builder",
    "prebuild:mac": "node scripts/vendor-assets.js",
    "build:mac": "electron-builder --mac",
    "prebuild:win": "node scripts/vendor-assets.js",
    "build:win": "electron-builder --win",
    "prebuild:linux": "node scripts/vendor-assets.js",
    "build:linux": "electron-builder --linux",
    "rebuild": "electron-builder install-app-deps",
    "postinstall": "node scripts/vendor-assets.js && electron-builder install-app-deps || true",
    "test": "node tests/run-all-tests.js",
    "test:install": "node tests/install.test.js",
    "test:unit": "node tests/run-with-electron.js tests/unit/run-unit-tests.js",
    "test:e2e": "npx playwright test --config playwright.config.js",
    "test:e2e:headed": "npx playwright test --config playwright.config.js --headed",
    "test:report": "node tests/generate-report.js",
    "test:pdf": "node tests/pdf-loading.test.js"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "electron-updater": "^6.8.9",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@google/generative-ai": "^0.24.1",
    "@playwright/test": "^1.49.1",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "pdfjs-dist": "^6.1.200",
    "playwright": "^1.49.1"
  },
  "build": {
    "appId": "com.reviewer2.app",
    "productName": "Reviewer 2",
    "executableName": "Reviewer2",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "!**/.DS_Store",
      "!src/logo/icon.iconset/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "YOUR_GITHUB_USERNAME",
      "repo": "reviewer",
      "releaseType": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "src/logo/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "icon": "src/logo/icon.ico",
      "target": {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      "signtoolOptions": {
        "certificateSubjectName": "Reviewer2",
        "signingHashAlgorithms": [
          "sha256"
        ]
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "icon": "src/logo/icon.ico",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    }
  }
}
